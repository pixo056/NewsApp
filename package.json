{
  "name": "uun-it-news",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check:publication": "node scripts/check-publication.mjs",
    "test:network": "node --experimental-strip-types --test config/network-access.test.ts",
    "test:frontend": "node --experimental-strip-types --test tests/frontend.test.ts",
    "test:launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-launcher.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts index.html docs README.md backend/README.md",
    "format:check": "prettier --check src vite.config.ts index.html docs README.md backend/README.md",
    "mobile:sync": "pnpm build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "format:java": "prettier --plugin=prettier-plugin-java --write \"backend/src/**/*.java\" scripts/CreateDatabase.java"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
